---
import type { PropDef } from "../data/api";

interface Props {
  props: PropDef[];
  component?: string;
}
const { props: propDefs, component } = Astro.props;
---
<div class="api-table-wrap">
  <div class="api-table-header">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
    <span>Props API{component ? <Fragment> — <code class="api-tag">{component}</code></Fragment> : ""}</span>
    <span class="api-count">{propDefs.length} atributos</span>
  </div>
  <div class="api-table-scroll">
    <table class="api-table">
      <thead>
        <tr>
          <th>Atributo</th>
          <th>Tipo</th>
          <th>Default</th>
          <th>Descripción</th>
        </tr>
      </thead>
      <tbody>
        {propDefs.map((p) => (
          <tr>
            <td>
              <code class="prop-name">{p.name}</code>
            </td>
            <td>
              <code class="prop-type" title={p.type}>{p.type}</code>
            </td>
            <td>
              {p.default === '—'
                ? <span class="prop-default-em">—</span>
                : <code class="prop-default">{p.default}</code>
              }
            </td>
            <td class="prop-desc">{p.desc}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<style>
  .api-table-wrap {
    margin-top: 8px;
    margin-bottom: 48px;
    border: 1px solid var(--sp-border-subtle);
    border-radius: 10px;
    overflow: hidden;
  }

  .api-table-header {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 9px 16px;
    background: var(--sp-bg-subtle);
    border-bottom: 1px solid var(--sp-border-subtle);
    font-size: .75rem;
    font-weight: 600;
    color: var(--sp-text-muted);
    text-transform: uppercase;
    letter-spacing: .06em;
  }
  .api-count {
    margin-left: auto;
    font-size: .65rem;
    font-weight: 500;
    padding: 2px 8px;
    border-radius: 9999px;
    background: var(--sp-bg-muted);
    color: var(--sp-text-muted);
    text-transform: none;
    letter-spacing: 0;
  }

  .api-tag {
    font-size: .75rem;
    font-weight: 600;
    color: var(--sp-primary);
    background: var(--sp-primary-bg);
    padding: 1px 6px;
    border-radius: 4px;
    text-transform: none;
    letter-spacing: 0;
  }

  .api-table-scroll {
    overflow-x: auto;
  }

  .api-table {
    width: 100%;
    border-collapse: collapse;
    font-size: .8rem;
  }

  .api-table thead tr {
    background: var(--sp-bg-muted);
  }

  .api-table th {
    padding: 7px 14px;
    text-align: left;
    font-size: .7rem;
    font-weight: 600;
    color: var(--sp-text-muted);
    text-transform: uppercase;
    letter-spacing: .05em;
    white-space: nowrap;
    border-bottom: 1px solid var(--sp-border);
  }

  .api-table td {
    padding: 8px 14px;
    border-bottom: 1px solid var(--sp-border-subtle);
    vertical-align: top;
    line-height: 1.5;
  }

  .api-table tbody tr:last-child td {
    border-bottom: none;
  }

  .api-table tbody tr:hover td {
    background: var(--sp-bg-subtle);
  }

  .prop-name {
    font-family: var(--font-mono);
    font-size: .78rem;
    font-weight: 600;
    color: var(--sp-text);
    white-space: nowrap;
  }

  .prop-type {
    font-family: var(--font-mono);
    font-size: .75rem;
    color: var(--sp-primary);
    background: var(--sp-primary-bg);
    padding: 1px 5px;
    border-radius: 4px;
    white-space: nowrap;
    display: inline-block;
    max-width: 320px;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .prop-default {
    font-family: var(--font-mono);
    font-size: .75rem;
    color: var(--sp-warning);
    background: var(--sp-warning-bg);
    padding: 1px 5px;
    border-radius: 4px;
    white-space: nowrap;
  }
  .prop-default-em {
    color: var(--sp-text-muted);
    font-size: .85rem;
  }

  .prop-desc {
    color: var(--sp-text-secondary);
    min-width: 160px;
    line-height: 1.6;
  }

  .api-table tbody tr:nth-child(even) td {
    background: var(--sp-bg-subtle);
  }
  .api-table tbody tr:hover td {
    background: var(--sp-primary-bg) !important;
  }
</style>
