  { id: "select", label: "sp-select" },
  { id: "combobox", label: "sp-combobox" },
  { id: "checkbox", label: "sp-checkbox" },
  { id: "switch", label: "sp-switch" },
  { id: "radio", label: "sp-radio" },
  { id: "slider", label: "sp-slider" },
  { id: "rating", label: "sp-rating" },
  { id: "number-input", label: "sp-number-input" },
  { id: "otp-input", label: "sp-otp-input" },
  { id: "tag-input", label: "sp-tag-input" },
  { id: "autocomplete", label: "sp-autocomplete" },
  { id: "file-upload", label: "sp-file-upload" },
  { id: "form-field", label: "sp-form-field" },
  { id: "time-picker", label: "sp-time-picker" },
  { id: "color-picker", label: "sp-color-picker" },
  { id: "tabs", label: "sp-tabs" },
  { id: "breadcrumb", label: "sp-breadcrumb" },
  { id: "pagination", label: "sp-pagination" },
  { id: "stepper", label: "sp-stepper" },
  { id: "menu", label: "sp-menu" },
  { id: "navbar", label: "sp-navbar" },
  { id: "sidebar-comp", label: "sp-sidebar" },
  { id: "modal", label: "sp-modal" },
  { id: "drawer", label: "sp-drawer" },
  { id: "tooltip", label: "sp-tooltip" },
  { id: "popover", label: "sp-popover" },
  { id: "toast", label: "sp-toast" },
  { id: "toast-stack", label: "sp-toast-stack" },
  { id: "confirm-dialog", label: "sp-confirm-dialog" },
  { id: "table", label: "sp-table" },
  { id: "accordion", label: "sp-accordion" },
  { id: "card", label: "sp-card" },
  { id: "badge", label: "sp-badge" },
  { id: "avatar", label: "sp-avatar" },
  { id: "stat", label: "sp-stat" },
  { id: "timeline", label: "sp-timeline" },
  { id: "tree", label: "sp-tree" },
  { id: "calendar", label: "sp-calendar" },
  { id: "gallery", label: "sp-gallery" },
