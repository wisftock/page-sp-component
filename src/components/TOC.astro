  { id: "command-palette", label: "sp-command-palette" },
];
---

<nav class="toc" id="toc" aria-label="En esta página">
  <div class="toc-title">En esta página</div>
  {sections.map((s) => (
    <a class="toc-item" href={`#${s.id}`} data-toc-id={s.id}>{s.label}</a>
  ))}
</nav>

<script>
  const tocItems = document.querySelectorAll<HTMLElement>('.toc-item[data-toc-id]');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          tocItems.forEach((el) => {
            el.classList.toggle('active', el.dataset.tocId === id);
          });
          // Scroll active item into view within TOC
          const active = document.querySelector<HTMLElement>(`.toc-item[data-toc-id="${id}"]`);
          active?.scrollIntoView({ block: 'nearest' });
        }
      });
    },
    { rootMargin: '-15% 0px -75% 0px' }
  );

  document.querySelectorAll<HTMLElement>('section.section[id]').forEach((el) => observer.observe(el));
</script>
