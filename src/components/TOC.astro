  { id: "alert", label: "sp-alert" },
  { id: "progress", label: "sp-progress-bar" },
  { id: "spinner", label: "sp-spinner" },
  { id: "skeleton", label: "sp-skeleton" },
  { id: "split-panel", label: "sp-split-panel" },
  { id: "scroll-area", label: "sp-scroll-area" },
