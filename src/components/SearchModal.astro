---

<div class="search-backdrop" id="search-backdrop" role="dialog" aria-modal="true" aria-label="Buscar componente">
  <div class="search-modal" id="search-modal">
    <div class="search-input-wrap">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      <input
        class="search-input"
        id="search-input"
        type="search"
        placeholder="Buscar componentes..."
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="search-kbd">Esc</kbd>
    </div>
    <div class="search-results" id="search-results" role="listbox"></div>
    <div class="search-footer">
      <span class="search-footer-hint"><kbd class="search-kbd">↑↓</kbd> navegar</span>
      <span class="search-footer-hint"><kbd class="search-kbd">↵</kbd> ir</span>
      <span class="search-footer-hint"><kbd class="search-kbd">Esc</kbd> cerrar</span>
    </div>
  </div>
</div>

<script define:vars={{ searchItems }}>
  const backdrop = document.getElementById('search-backdrop');
  const input = document.getElementById('search-input');
  const resultsEl = document.getElementById('search-results');
  let activeIdx = -1;
  let filtered = [];

  function open() {
    backdrop.classList.add('open');
    setTimeout(() => input?.focus(), 50);
    renderResults('');
  }

  function close() {
    backdrop.classList.remove('open');
    input.value = '';
    activeIdx = -1;
  }

  function renderResults(q) {
    const query = q.toLowerCase().trim();
    if (!query) {
      filtered = searchItems.slice(0, 12);
    } else {
      filtered = searchItems.filter(item =>
        item.label.toLowerCase().includes(query) ||
        item.category.toLowerCase().includes(query) ||
        item.id.toLowerCase().includes(query)
      );
    }

    if (filtered.length === 0) {
      resultsEl.innerHTML = `<div class="search-empty">No se encontraron componentes para "<strong>${q}</strong>"</div>`;
      return;
    }

    // Group by category
    const byCategory = {};
    filtered.forEach(item => {
      if (!byCategory[item.category]) byCategory[item.category] = [];
      byCategory[item.category].push(item);
    });

    let html = '';
    Object.entries(byCategory).forEach(([cat, items]) => {
      if (!query) html += `<div class="search-group-title">${cat}</div>`;
      items.forEach((item, i) => {
        const globalIdx = filtered.indexOf(item);
        html += `
          <a class="search-item${globalIdx === activeIdx ? ' active' : ''}"
             href="#${item.id}"
             data-idx="${globalIdx}"
             role="option"
             aria-selected="${globalIdx === activeIdx}">
            <div class="search-item-icon">${item.icon}</div>
            <div>
              <div class="search-item-name">${item.label}</div>
              ${query ? `<div class="search-item-cat">${item.category}</div>` : ''}
            </div>
          </a>`;
      });
    });

    resultsEl.innerHTML = html;
  }

  input?.addEventListener('input', (e) => {
    activeIdx = -1;
    renderResults(e.target.value);
  });

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      activeIdx = Math.min(activeIdx + 1, filtered.length - 1);
      renderResults(input.value);
      resultsEl.querySelector('.search-item.active')?.scrollIntoView({ block: 'nearest' });
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      activeIdx = Math.max(activeIdx - 1, 0);
      renderResults(input.value);
      resultsEl.querySelector('.search-item.active')?.scrollIntoView({ block: 'nearest' });
    } else if (e.key === 'Enter') {
      e.preventDefault();
      const active = filtered[activeIdx] || filtered[0];
      if (active) {
        window.location.hash = active.id;
        close();
      }
    } else if (e.key === 'Escape') {
      close();
    }
  });

  resultsEl?.addEventListener('click', (e) => {
    const item = e.target.closest('.search-item');
    if (item) {
      close();
    }
  });

  backdrop?.addEventListener('click', (e) => {
    if (e.target === backdrop) close();
  });

  // Expose open globally for other components
  window.__searchOpen = open;

  // Cmd+K / Ctrl+K
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      if (backdrop.classList.contains('open')) close();
      else open();
    }
  });
</script>
