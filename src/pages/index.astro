        GitHub
      </a>
      <a href="https://gitlab.com/wisftock/sp-component" target="_blank" rel="noopener" class="topbar-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M22.65 14.39L12 22.13 1.35 14.39a.84.84 0 01-.3-.94l1.22-3.78 2.44-7.51A.42.42 0 014.82 2a.43.43 0 01.58 0 .42.42 0 01.11.18l2.44 7.49h8.1l2.44-7.51A.42.42 0 0118.6 2a.43.43 0 01.58 0 .42.42 0 01.11.18l2.44 7.51L23 13.45a.84.84 0 01-.35.94z"/></svg>
        GitLab
      </a>
    </nav>

    <div class="topbar-right">
      <button class="search-trigger" id="search-trigger" aria-label="Buscar componente">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <span class="search-trigger-text">Buscar…</span>
        <kbd class="search-kbd">⌘K</kbd>
      </button>
      <button class="theme-btn" id="theme-toggle" aria-label="Cambiar tema">🌙</button>
      <button class="topbar-menu-btn" id="mobile-menu-btn" aria-label="Abrir menú" aria-expanded="false">
        <svg id="menu-icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        <svg id="menu-icon-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </header>

  <!-- ── Mobile nav ────────────────────────────────────────────────────────── -->
  <nav class="mobile-nav" id="mobile-nav" hidden>
    <a href="#components" class="mobile-nav-link" id="mnav-components">Componentes</a>
    <a href="#getting-started" class="mobile-nav-link" id="mnav-install">Instalación</a>
    <div class="mobile-nav-sep"></div>
    <a href="https://sp-component-182cbe.gitlab.io" target="_blank" rel="noopener" class="mobile-nav-link">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M16.34.24l-.12 2.71a.18.18 0 00.29.15l1.06-.8.9.7a.18.18 0 00.28-.14L18.65 0zM9.8 4.47C4.37 4.47 0 6.67 0 9.4c0 1.37 1.06 2.62 2.8 3.56L3 11.48a.48.48 0 01.64-.63l.8.36a4 4 0 00-.31-1.73c1.05-.43 2.37-.69 3.82-.69 3.2 0 5.77 1.35 5.77 3.02 0 .58-.3 1.12-.83 1.58l.97.43a.48.48 0 01.02.86l-.8.37.2 1.53c1.57-.94 2.53-2.14 2.53-3.44 0-2.73-4.37-4.94-9.81-4.94zm8.34 1.66l-1.51.22-.07 1.12a5.3 5.3 0 00-1.12-.12c-3.51 0-6.32 1.76-6.32 3.95 0 2.18 2.8 3.95 6.32 3.95s6.32-1.77 6.32-3.95c0-1.54-1.35-2.89-3.33-3.6l-.3-1.57zM6.6 11.17a.53.53 0 110 1.06.53.53 0 010-1.06zm6.78 0a.53.53 0 110 1.06.53.53 0 010-1.06z"/></svg>
      Storybook
