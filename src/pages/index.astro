  .idx-search-hint kbd {
    font-family: var(--font-mono); font-size: .65rem;
    background: var(--sp-bg-muted); border: 1px solid var(--sp-border);
    padding: 1px 5px; border-radius: 3px; color: var(--sp-text-secondary);
  }
  .idx-search-empty {
    padding: 36px 24px; text-align: center;
    color: var(--sp-text-muted); font-size: .9rem;
  }
  .idx-search-empty strong { color: var(--sp-text); }

  /* ── Keyboard shortcuts modal ──────────────────────────────────────────── */
  .shortcuts-overlay {
    position: fixed; inset: 0; z-index: 500;
    display: flex; align-items: center; justify-content: center;
    padding: 24px;
  }
  .shortcuts-overlay[hidden] { display: none; }
