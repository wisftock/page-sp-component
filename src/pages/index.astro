---
import BaseLayout from "../layouts/BaseLayout.astro";
import { components, categories, componentStatuses, componentSizes } from "../data/components";
const compData = components.map(c => ({ slug: c.slug, label: c.label, tag: c.tag, desc: c.desc ?? '' }));
---

<BaseLayout title="SP Components — Librería de Web Components" description="Librería de Web Components construida con Lit. Compatible con cualquier framework o HTML vainilla.">

  <!-- ── Top bar ──────────────────────────────────────────────────────────── -->
