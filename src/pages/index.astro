  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="hero" id="hero">
    <div class="hero-inner">
      <div class="hero-badge">v1.0.0 — Estable</div>
      <h1 class="hero-title">Componentes UI<br/>para la web moderna</h1>
      <p class="hero-sub">
        {components.length} Web Components construidos con Lit. Sin dependencias, accesibles, con dark mode y compatibles con cualquier framework — o solo HTML vainilla.
      </p>
      <div class="hero-chips">
        <sp-tag variant="primary">Dark mode</sp-tag>
        <sp-tag>Form-associated</sp-tag>
        <sp-tag>ARIA compliant</sp-tag>
        <sp-tag>TypeScript</sp-tag>
        <sp-tag>Tree-shakeable</sp-tag>
      </div>
      <div class="hero-actions">
        <sp-button variant="primary" href="#components" size="lg">Explorar componentes</sp-button>
        <sp-button variant="secondary" href="#getting-started" size="lg">Instalación</sp-button>
        <sp-button variant="ghost" href="https://github.com/wisftock/sp-component" target="_blank">GitHub</sp-button>
        <sp-button variant="ghost" href="https://gitlab.com/wisftock/sp-component" target="_blank">GitLab</sp-button>
        <sp-button variant="ghost" href="https://sp-component-182cbe.gitlab.io" target="_blank">Storybook</sp-button>
      </div>
    </div>

    <!-- Stats -->
    <div class="hero-stats">
      <sp-stat value={String(components.length)} label="componentes"></sp-stat>
      <div class="stat-sep"></div>
      <sp-stat value={String(categories.length)} label="categorías"></sp-stat>
      <div class="stat-sep"></div>
      <sp-stat value="0" label="dependencias"></sp-stat>
      <div class="stat-sep"></div>
      <sp-stat value="A11Y" label="accesible"></sp-stat>
    </div>
  </section>

  <!-- ── Getting Started ───────────────────────────────────────────────────── -->
  <section class="section" id="getting-started">
    <div class="section-inner">
      <div class="section-header">
        <h2 class="section-title">Instalación</h2>
        <p class="section-sub">Empieza en segundos — elige la forma que prefieras</p>
      </div>

      <div class="install-grid">
        <div class="install-card">
          <div class="install-card-head">
            <span class="install-icon">📦</span>
            <span class="install-label">npm / pnpm / yarn</span>
          </div>
          <pre class="install-code"><code id="c1">npm install sp-component</code></pre>
          <div class="install-tabs">
            <button class="itab itab--active" data-cmd="npm install sp-component" data-target="c1">npm</button>
            <button class="itab" data-cmd="pnpm add sp-component" data-target="c1">pnpm</button>
            <button class="itab" data-cmd="yarn add sp-component" data-target="c1">yarn</button>
          </div>
        </div>

        <div class="install-card">
          <div class="install-card-head">
            <span class="install-icon">🔗</span>
            <span class="install-label">CDN — sin instalación</span>
          </div>
          <pre class="install-code"><code>&lt;script type="module"
  src="https://unpkg.com/sp-component"&gt;
&lt;/script&gt;</code></pre>
        </div>

        <div class="install-card">
          <div class="install-card-head">
            <span class="install-icon">⚡</span>
            <span class="install-label">Importar y usar</span>
          </div>
          <pre class="install-code"><code>import 'sp-component/button';
// o todo el bundle:
import 'sp-component';

// En HTML:
&lt;sp-button&gt;Hola mundo&lt;/sp-button&gt;</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Component catalog ─────────────────────────────────────────────────── -->
  <section class="section" id="components">
    <div class="section-inner">
      <div class="section-header">
        <h2 class="section-title">Componentes</h2>
        <p class="section-sub">{components.length} componentes listos para producción, organizados por categoría</p>
      </div>

      <!-- Search bar — usando sp-input del propio sistema de diseño -->
      <div class="cat-search-wrap">
        <sp-input
          id="cat-search"
          placeholder="Buscar por nombre, tag o descripción…"
          clearable
          autocomplete="off"
          spellcheck="false"
          class="cat-search-input"
        ></sp-input>
      </div>

      <!-- Category filters -->
      <div class="cat-filters" id="cat-filters">
        <button class="cat-filter cat-filter--active" data-cat="">Todos ({components.length})</button>
        {categories.map(cat => (
          <button class="cat-filter" data-cat={cat}>
            {cat} ({components.filter(c => c.category === cat).length})
          </button>
        ))}
      </div>

      <!-- Component grid -->
      {categories.map(cat => (
        <div class="cat-group" data-category={cat}>
          <h3 class="cat-group-title">{cat}</h3>
          <div class="comp-grid">
            {components.filter(c => c.category === cat).map(c => (
              <a class="comp-card" href={`${import.meta.env.BASE_URL}components/${c.slug}`} data-name={c.label.toLowerCase()} data-tag={c.tag} data-desc={c.desc.toLowerCase()}>
                <div class="comp-card-body">
                  <div class="comp-card-name-row">
                    <span class="comp-card-name">{c.label}</span>
                    {componentStatuses[c.slug] === 'new' && <span class="comp-status-badge comp-status-badge--new">Nuevo</span>}
                    {componentStatuses[c.slug] === 'beta' && <span class="comp-status-badge comp-status-badge--beta">Beta</span>}
                  </div>
                  <div class="comp-card-tag">&lt;{c.tag}&gt;</div>
                  <div class="comp-card-desc">{c.desc}</div>
                  {componentSizes[c.slug] && <div class="comp-card-size">{componentSizes[c.slug]} min+gz</div>}
                </div>
                <div class="comp-card-arrow">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}

      <!-- Empty state for search -->
      <div class="no-results" id="no-results" hidden>
        <div class="no-results-icon">🔍</div>
        <div class="no-results-title">Sin resultados</div>
        <div class="no-results-sub">Prueba con otro término de búsqueda</div>
      </div>
    </div>
  </section>

  <!-- ── Footer ────────────────────────────────────────────────────────────── -->
  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7" rx="1"/>
          <rect x="14" y="3" width="7" height="7" rx="1"/>
          <rect x="3" y="14" width="7" height="7" rx="1"/>
          <rect x="14" y="14" width="7" height="7" rx="1"/>
        </svg>
        <span>SP Components</span>
      </div>
      <div class="footer-links">
        <a href="#getting-started">Instalación</a>
        <a href="#components">Componentes</a>
        <a href="https://github.com/wisftock/sp-component" target="_blank" rel="noopener">GitHub</a>
        <a href="https://gitlab.com/wisftock/sp-component" target="_blank" rel="noopener">GitLab</a>
        <a href="https://sp-component-182cbe.gitlab.io" target="_blank" rel="noopener">Storybook</a>
      </div>
      <div class="footer-note">Construido con Lit · TypeScript · Astro</div>
    </div>
  </footer>

  <!-- ── Keyboard shortcuts modal ─────────────────────────────────────────── -->
  <div class="shortcuts-overlay" id="shortcuts-modal" hidden role="dialog" aria-modal="true" aria-label="Atajos de teclado">
    <div class="shortcuts-backdrop" id="shortcuts-backdrop"></div>
    <div class="shortcuts-box">
      <div class="shortcuts-header">
        <h2 class="shortcuts-title">Atajos de teclado</h2>
        <button class="shortcuts-close" id="shortcuts-close" aria-label="Cerrar">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="shortcuts-body">
        <div class="shortcuts-group">
          <div class="shortcuts-group-title">Búsqueda</div>
          <div class="shortcuts-row"><kbd>⌘K</kbd><span>Abrir buscador de componentes</span></div>
          <div class="shortcuts-row"><kbd>↑</kbd> <kbd>↓</kbd><span>Navegar resultados</span></div>
          <div class="shortcuts-row"><kbd>↵</kbd><span>Abrir componente seleccionado</span></div>
          <div class="shortcuts-row"><kbd>Esc</kbd><span>Cerrar modal</span></div>
        </div>
        <div class="shortcuts-group">
          <div class="shortcuts-group-title">Interfaz</div>
          <div class="shortcuts-row"><kbd>?</kbd><span>Mostrar / ocultar esta pantalla</span></div>
          <div class="shortcuts-row"><kbd>D</kbd><span>Alternar tema oscuro / claro</span></div>
        </div>
        <div class="shortcuts-group">
          <div class="shortcuts-group-title">Catálogo</div>
          <div class="shortcuts-row"><kbd>1</kbd> – <kbd>9</kbd><span>Filtrar por categoría</span></div>
          <div class="shortcuts-row"><kbd>0</kbd><span>Mostrar todos los componentes</span></div>
        </div>
      </div>
      <div class="shortcuts-footer">Pulsa <kbd>Esc</kbd> o <kbd>?</kbd> para cerrar</div>
    </div>
  </div>

  <!-- ── Search modal ─────────────────────────────────────────────────────── -->
  <div class="idx-search-overlay" id="search-modal" hidden role="dialog" aria-modal="true" aria-label="Buscar componente">
    <div class="idx-search-backdrop" id="search-backdrop"></div>
    <div class="idx-search-box">
      <div class="idx-search-input-wrap">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input id="search-modal-input" class="idx-search-input" type="text" placeholder="Buscar componente…" autocomplete="off" aria-label="Buscar" />
        <kbd class="idx-search-esc">Esc</kbd>
      </div>
      <div class="idx-search-results" id="search-modal-results"></div>
      <div class="idx-search-footer">
        <span class="idx-search-hint"><kbd>↑</kbd><kbd>↓</kbd> navegar</span>
        <span class="idx-search-hint"><kbd>↵</kbd> abrir</span>
        <span class="idx-search-hint"><kbd>Esc</kbd> cerrar</span>
      </div>
    </div>
  </div>

</BaseLayout>

<script define:vars={{ compData, BASE_URL: import.meta.env.BASE_URL }} is:inline>
  window.__COMP_DATA__ = compData;
  window.__BASE_URL__ = BASE_URL;
</script>

<script>
  // ── Theme toggle ─────────────────────────────────────────────────────────
  const themeBtn = document.getElementById('theme-toggle') as HTMLButtonElement;
  function syncTheme() {
    const dark = document.documentElement.getAttribute('data-theme') === 'dark';
    if (themeBtn) themeBtn.textContent = dark ? '☀️' : '🌙';
  }
  syncTheme();
  themeBtn?.addEventListener('click', () => {
    const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('sp-theme', next);
    syncTheme();
  });

  // ── Install tabs ─────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.itab').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = document.getElementById(btn.dataset.target!);
      if (target) target.textContent = btn.dataset.cmd!;
      btn.closest('.install-card')?.querySelectorAll('.itab').forEach(b => b.classList.remove('itab--active'));
      btn.classList.add('itab--active');
    });
  });

  // ── Category filter ───────────────────────────────────────────────────────
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.cat-filter');
  const catGroups  = document.querySelectorAll<HTMLElement>('.cat-group');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('cat-filter--active'));
      btn.classList.add('cat-filter--active');
      const cat = btn.dataset.cat;
      catGroups.forEach(g => {
        g.hidden = !!(cat && g.dataset.category !== cat);
      });
    });
  });

  // ── Inline search — sp-input ─────────────────────────────────────────────
  const noResults   = document.getElementById('no-results') as HTMLElement;
  const allCards    = document.querySelectorAll<HTMLAnchorElement>('.comp-card');
  const catSearchEl = document.getElementById('cat-search') as HTMLElement & { value?: string };

  function runSearch(q: string) {
    const query = q.toLowerCase().trim();
    let visible = 0;

    if (query) {
      filterBtns.forEach(b => b.classList.remove('cat-filter--active'));
      filterBtns[0]?.classList.add('cat-filter--active');
      catGroups.forEach(g => g.hidden = false);
    }

    allCards.forEach(card => {
      const match = !query
        || (card.dataset.name ?? '').includes(query)
        || (card.dataset.tag ?? '').includes(query)
        || (card.dataset.desc ?? '').includes(query);
      (card as HTMLElement).style.display = match ? '' : 'none';
      if (match) visible++;
    });

    catGroups.forEach(g => {
      const hasVisible = Array.from(g.querySelectorAll('.comp-card')).some(c => (c as HTMLElement).style.display !== 'none');
      g.hidden = !hasVisible;
    });

    noResults.hidden = visible > 0;
  }

  // sp-input dispara el evento personalizado 'sp-input' con detail.value
  catSearchEl?.addEventListener('sp-input', (e: Event) => {
    runSearch((e as CustomEvent).detail?.value ?? '');
  });
  // Fallback: si por alguna razón el evento nativo 'input' llega al host
  catSearchEl?.addEventListener('input', () => {
    runSearch(catSearchEl.value ?? '');
  });
  catSearchEl?.addEventListener('sp-clear', () => runSearch(''));

  // ── Mobile nav toggle ─────────────────────────────────────────────────────
  const mobileMenuBtn = document.getElementById('mobile-menu-btn') as HTMLButtonElement;
  const mobileNav     = document.getElementById('mobile-nav') as HTMLElement;
  const menuIconOpen  = document.getElementById('menu-icon-open') as SVGElement;
  const menuIconClose = document.getElementById('menu-icon-close') as SVGElement;

  mobileMenuBtn?.addEventListener('click', () => {
    const isOpen = !mobileNav.hidden;
    mobileNav.hidden = isOpen;
    mobileMenuBtn.setAttribute('aria-expanded', String(!isOpen));
    menuIconOpen.style.display  = isOpen ? '' : 'none';
    menuIconClose.style.display = isOpen ? 'none' : '';
  });

  mobileNav?.querySelectorAll<HTMLAnchorElement>('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      mobileNav.hidden = true;
      mobileMenuBtn.setAttribute('aria-expanded', 'false');
      menuIconOpen.style.display  = '';
      menuIconClose.style.display = 'none';
    });
  });

  // ── Global search modal (⌘K) ─────────────────────────────────────────────
  const modal        = document.getElementById('search-modal') as HTMLElement;
  const modalInput   = document.getElementById('search-modal-input') as HTMLInputElement;
  const modalResults = document.getElementById('search-modal-results') as HTMLElement;
  const backdrop     = document.getElementById('search-backdrop') as HTMLElement;
  const trigger      = document.getElementById('search-trigger') as HTMLButtonElement;

  const COMP_DATA = (window as any).__COMP_DATA__ as { slug: string; label: string; tag: string; desc: string }[];

  function renderResults(q: string) {
    const results = q
      ? COMP_DATA.filter(c =>
          c.label.toLowerCase().includes(q) ||
          c.tag.toLowerCase().includes(q) ||
          c.desc.toLowerCase().includes(q)
        ).slice(0, 10)
      : COMP_DATA.slice(0, 8);

    if (!results.length) {
      modalResults.innerHTML = `<div class="idx-search-empty">Sin resultados para "<strong>${q}</strong>"</div>`;
      return;
    }
    modalResults.innerHTML = results.map((c, i) => `
      <a class="idx-search-result${i === 0 ? ' idx-search-result--active' : ''}" href="${(window as any).__BASE_URL__}components/${c.slug}">
        <span class="idx-search-result-label">${c.label}</span>
        <span class="idx-search-result-tag">&lt;${c.tag}&gt;</span>
      </a>
    `).join('');
  }

  function openModal() {
    modal.hidden = false;
    modalInput.value = '';
    renderResults('');
    requestAnimationFrame(() => modalInput.focus());
  }
  function closeModal() { modal.hidden = true; }

  trigger?.addEventListener('click', openModal);
  backdrop?.addEventListener('click', closeModal);
  document.addEventListener('keydown', e => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); openModal(); }
    if (e.key === 'Escape' && !modal.hidden) closeModal();
  });

  modalInput?.addEventListener('input', () => renderResults(modalInput.value.toLowerCase().trim()));

  modalResults?.addEventListener('click', e => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('.idx-search-result');
    if (a) { closeModal(); window.location.href = a.href; }
  });

  // ── Keyboard shortcuts modal (?  key) ────────────────────────────────────
  const shortcutsModal  = document.getElementById('shortcuts-modal') as HTMLElement;
  const shortcutsBackdrop = document.getElementById('shortcuts-backdrop') as HTMLElement;
  const shortcutsClose  = document.getElementById('shortcuts-close') as HTMLButtonElement;

  function openShortcuts()  { shortcutsModal.hidden = false; }
  function closeShortcuts() { shortcutsModal.hidden = true;  }

  shortcutsClose?.addEventListener('click', closeShortcuts);
  shortcutsBackdrop?.addEventListener('click', closeShortcuts);

  document.addEventListener('keydown', e => {
    const active = document.activeElement as HTMLElement;
    const typing = ['INPUT','TEXTAREA','SELECT'].includes(active?.tagName ?? '') || active?.isContentEditable;
    if (typing) return;

    if (e.key === '?') { e.preventDefault(); shortcutsModal.hidden ? openShortcuts() : closeShortcuts(); }
    if (e.key === 'Escape' && !shortcutsModal.hidden) { closeShortcuts(); }

    // D → toggle dark mode
    if (e.key === 'd' || e.key === 'D') {
      const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('sp-theme', next);
      const tb = document.getElementById('theme-toggle');
      if (tb) tb.textContent = next === 'dark' ? '☀️' : '🌙';
    }

    // 0-9 → category filter shortcuts
    if (/^[0-9]$/.test(e.key) && !e.metaKey && !e.ctrlKey) {
      const idx = parseInt(e.key);
      const btns = document.querySelectorAll<HTMLButtonElement>('.cat-filter');
      if (idx === 0) btns[0]?.click();
      else if (btns[idx]) btns[idx].click();
    }
  });

  // ── Scroll entrance animations ────────────────────────────────────────────
  const animCards = document.querySelectorAll<HTMLElement>('.comp-card');
  animCards.forEach(card => {
    card.style.opacity = '0';
    card.style.transform = 'translateY(14px)';
  });

  const cardObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry, i) => {
      if (entry.isIntersecting) {
        const el = entry.target as HTMLElement;
        setTimeout(() => {
          el.style.transition = 'opacity 0.35s ease, transform 0.35s ease';
          el.style.opacity = '1';
          el.style.transform = 'translateY(0)';
        }, i * 25);
        cardObserver.unobserve(el);
      }
    });
  }, { threshold: 0.05, rootMargin: '0px 0px -30px 0px' });

  animCards.forEach(card => cardObserver.observe(card));

  modalInput?.addEventListener('keydown', e => {
    const items = modalResults.querySelectorAll<HTMLElement>('.idx-search-result');
    const activeIdx = Array.from(items).findIndex(el => el.classList.contains('idx-search-result--active'));
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      const next = Math.min(activeIdx + 1, items.length - 1);
      items.forEach(el => el.classList.remove('idx-search-result--active'));
      items[next]?.classList.add('idx-search-result--active');
      items[next]?.scrollIntoView({ block: 'nearest' });
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      const prev = Math.max(activeIdx - 1, 0);
      items.forEach(el => el.classList.remove('idx-search-result--active'));
      items[prev]?.classList.add('idx-search-result--active');
      items[prev]?.scrollIntoView({ block: 'nearest' });
    } else if (e.key === 'Enter') {
      const active = modalResults.querySelector<HTMLAnchorElement>('.idx-search-result--active');
      if (active) { closeModal(); window.location.href = active.href; }
    }
  });
</script>

<style>
