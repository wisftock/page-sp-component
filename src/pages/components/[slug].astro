---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ApiTable from "../../components/ApiTable.astro";
import { components, componentsBySlug, categories, componentStatuses, componentSizes } from "../../data/components";
import { api } from "../../data/api";
import { docs } from "../../data/docs";

export function getStaticPaths() {
  return components.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const comp = componentsBySlug[slug];
if (!comp) return Astro.redirect("/");

const propDefs = api[comp.indexId] ?? api[comp.slug] ?? [];
const doc = docs[comp.slug] ?? {};
const catComponents = components.filter((c) => c.category === comp.category && c.slug !== comp.slug);

// Sections for TOC
const sections = [
  { id: "installation", label: "Instalación" },
  ...((doc.usage || (doc as any).demo) ? [{ id: "demo",  label: "Demo en vivo" }] : []),
  { id: "usage",        label: "Código" },
  ...(propDefs.length > 0                  ? [{ id: "api",     label: "API / Props" }] : []),
  ...(doc.events && doc.events.length > 0  ? [{ id: "events",  label: "Eventos" }] : []),
  ...(doc.slots  && doc.slots.length  > 0  ? [{ id: "slots",   label: "Slots" }] : []),
  ...(catComponents.length > 0             ? [{ id: "related", label: "Relacionados" }] : []),
];

// Strip <script> tags for the live preview
function demoHtml(usage: string): string {
  return usage.replace(/<script[\s\S]*?<\/script>/gi, '').trim();
}
// If doc.demo exists, use it as-is (scripts allowed); otherwise strip scripts from usage
const liveDemo = (doc as any).demo ?? (doc.usage ? demoHtml(doc.usage) : null);

// Escape HTML for code display
function esc(s: string) {
  return s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
}

// Syntax‑highlight a usage snippet
function highlightUsage(raw: string): string {
  return esc(raw)
    // tag names
    .replace(/(&lt;\/?)(sp-[\w-]+)/g, '$1<span class="hl-tag">$2</span>')
    // attribute names
    .replace(/\s([\w-]+)(=|&gt;|\s|$)/g, (m, name, after) =>
      after === "="
        ? ` <span class="hl-attr">${name}</span>=`
        : ` <span class="hl-attr">${name}</span>${after}`)
    // attribute values (quoted)
    .replace(/=(&quot;[^&]*&quot;)/g, '=<span class="hl-val">$1</span>')
    // JS comments
    .replace(/(\/\/[^\n]*)/g, '<span class="hl-comment">$1</span>')
    // JS keywords
    .replace(/\b(const|let|var|function|document|getElementById|addEventListener|import|from|return)\b/g,
      '<span class="hl-kw">$1</span>');
}

const usageHtml = doc.usage ? highlightUsage(doc.usage) : null;
---

<BaseLayout title={`${comp.label} — SP Components`} description={comp.desc}>
  <div class="comp-page">

    <!-- ── Left sidebar ──────────────────────────────────────────────────── -->
    <nav class="comp-sidebar" id="comp-sidebar">
      <a class="comp-sidebar-logo" href={import.meta.env.BASE_URL}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7" rx="1"/>
          <rect x="14" y="3" width="7" height="7" rx="1"/>
          <rect x="3" y="14" width="7" height="7" rx="1"/>
          <rect x="14" y="14" width="7" height="7" rx="1"/>
        </svg>
        SP Components
      </a>

      <div class="comp-nav-back">
        <a href={import.meta.env.BASE_URL} class="comp-nav-back-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
          Todos los componentes
        </a>
      </div>

      {categories.map((cat) => {
        const items = components.filter((c) => c.category === cat);
        return (
          <div class="comp-nav-group">
            <div class="comp-nav-title">{cat}</div>
            {items.map((c) => (
              <a
                class={`comp-nav-item${c.slug === slug ? ' active' : ''}`}
                href={`${import.meta.env.BASE_URL}components/${c.slug}`}
              >
                {c.label}
              </a>
            ))}
          </div>
        );
      })}
    </nav>

    <!-- ── Main content ──────────────────────────────────────────────────── -->
    <main class="comp-main">

      <!-- Breadcrumb -->
      <nav class="comp-breadcrumb" aria-label="Breadcrumb">
        <a href={import.meta.env.BASE_URL} class="comp-bc-link">Inicio</a>
        <span class="comp-bc-sep">›</span>
        <a href={import.meta.env.BASE_URL} class="comp-bc-link">Componentes</a>
        <span class="comp-bc-sep">›</span>
        <span class="comp-bc-current">{comp.label}</span>
      </nav>

      <!-- Component header -->
      <div class="comp-header">
        <div class="comp-header-initial">{comp.label.charAt(0)}</div>
        <div>
          <div class="comp-header-category">{comp.category}</div>
          <h1 class="comp-header-title">{comp.label}</h1>
          <p class="comp-header-desc">{comp.desc}</p>
        </div>
      </div>

      <!-- Tag + links row -->
      <div class="comp-tag-row">
        <code class="comp-tag-badge">&lt;{comp.tag}&gt;</code>
        {componentStatuses[comp.slug] === 'new' && <span class="comp-status-pill comp-status-pill--new">Nuevo</span>}
        {componentStatuses[comp.slug] === 'beta' && <span class="comp-status-pill comp-status-pill--beta">Beta</span>}
        {!componentStatuses[comp.slug] && <span class="comp-status-pill comp-status-pill--stable">Estable</span>}
        {componentSizes[comp.slug] && <span class="comp-size-pill">{componentSizes[comp.slug]} min+gz</span>}
        <a href={`${import.meta.env.BASE_URL}#${comp.indexId}`} class="comp-view-demo-link">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
          Ver demo
        </a>
        <a href="https://stackblitz.com/fork/web-platform" target="_blank" rel="noopener" class="comp-stackblitz-link">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M10.797 14.182H3.635L16.728 0l-3.525 9.818H20.3L7.188 24z"/></svg>
          StackBlitz
        </a>
      </div>

      <!-- ── Instalación ────────────────────────────────────────────────── -->
      <section class="comp-section" id="installation">
        <h2 class="comp-section-title">Instalación</h2>

        <div class="comp-step-list">
          <div class="comp-step">
            <div class="comp-step-num">1</div>
            <div class="comp-step-body">
              <p class="comp-step-desc">Instala el paquete:</p>
              <pre class="comp-code-block"><code><span class="hl-comment"># npm</span>
<span class="hl-kw">npm</span> install sp-component

<span class="hl-comment"># pnpm</span>
<span class="hl-kw">pnpm</span> add sp-component

<span class="hl-comment"># yarn</span>
<span class="hl-kw">yarn</span> add sp-component</code></pre>
            </div>
          </div>

          <div class="comp-step">
            <div class="comp-step-num">2</div>
            <div class="comp-step-body">
              <p class="comp-step-desc">Importa el componente (o el bundle completo):</p>
              <pre class="comp-code-block"><code><span class="hl-comment">// Solo este componente</span>
<span class="hl-kw">import</span> <span class="hl-val">'{comp.tag}'</span>;

<span class="hl-comment">// O todos los componentes</span>
<span class="hl-kw">import</span> <span class="hl-val">'sp-component'</span>;</code></pre>
            </div>
          </div>

          <div class="comp-step">
            <div class="comp-step-num">3</div>
            <div class="comp-step-body">
              <p class="comp-step-desc">O mediante CDN sin instalación:</p>
              <pre class="comp-code-block"><code><span class="hl-tag">&lt;script</span> <span class="hl-attr">type</span>=<span class="hl-val">"module"</span>
        <span class="hl-attr">src</span>=<span class="hl-val">"https://unpkg.com/sp-component"</span><span class="hl-tag">&gt;</span><span class="hl-tag">&lt;/script&gt;</span></code></pre>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Demo en vivo ─────────────────────────────────────────────── -->
      {liveDemo && (
        <section class="comp-section" id="demo">
          <h2 class="comp-section-title">Demo en vivo</h2>
          <div class="comp-demo-preview">
            <Fragment set:html={liveDemo} />
          </div>
        </section>
      )}

      <!-- ── Código ────────────────────────────────────────────────────── -->
      <section class="comp-section" id="usage">
        <h2 class="comp-section-title">Código</h2>

        {usageHtml ? (
          <div class="comp-code-wrap">
            <div class="comp-code-header">
              <span class="comp-code-lang">HTML</span>
              <button class="comp-copy-btn" data-copy={doc.usage} aria-label="Copiar código">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                </svg>
                Copiar
              </button>
            </div>
            <pre class="comp-code-block"><code set:html={usageHtml} /></pre>
          </div>
        ) : (
          <div class="comp-code-wrap">
            <div class="comp-code-header">
              <span class="comp-code-lang">HTML</span>
            </div>
            <pre class="comp-code-block"><code><span class="hl-comment">&lt;!-- Uso básico --&gt;</span>
&lt;<span class="hl-tag">{comp.tag}</span>&gt;
  Contenido
&lt;/<span class="hl-tag">{comp.tag}</span>&gt;</code></pre>
          </div>
        )}
      </section>

      <!-- ── API / Props ────────────────────────────────────────────────── -->
      {propDefs.length > 0 && (
        <section class="comp-section" id="api">
          <h2 class="comp-section-title">API / Props</h2>
          <ApiTable props={propDefs} component={comp.tag} />
        </section>
      )}

      <!-- ── Eventos ────────────────────────────────────────────────────── -->
      {doc.events && doc.events.length > 0 && (
        <section class="comp-section" id="events">
          <h2 class="comp-section-title">Eventos</h2>
          <div class="comp-events-table-wrap">
            <table class="comp-events-table">
              <thead>
                <tr>
                  <th>Evento</th>
                  <th>detail</th>
                  <th>Descripción</th>
                </tr>
              </thead>
              <tbody>
                {doc.events.map((ev) => (
                  <tr>
                    <td><code class="comp-event-name">{ev.name}</code></td>
                    <td><code class="comp-event-detail">{ev.detail}</code></td>
                    <td class="comp-event-desc">{ev.desc}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="comp-note">
            Escucha con <code>element.addEventListener('{doc.events[0]?.name ?? 'evento'}', handler)</code> o usando el atributo <code>@{doc.events[0]?.name ?? 'evento'}</code> en frameworks.
          </p>
        </section>
      )}

      <!-- ── Slots ──────────────────────────────────────────────────────── -->
      {doc.slots && doc.slots.length > 0 && (
        <section class="comp-section" id="slots">
          <h2 class="comp-section-title">Slots</h2>
          <div class="comp-events-table-wrap">
            <table class="comp-events-table">
              <thead>
                <tr>
                  <th>Slot</th>
                  <th>Descripción</th>
                </tr>
              </thead>
              <tbody>
                {doc.slots.map((sl) => (
                  <tr>
                    <td><code class="comp-event-name">{sl.name}</code></td>
                    <td class="comp-event-desc">{sl.desc}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <!-- ── Accesibilidad ──────────────────────────────────────────────── -->
      <section class="comp-section" id="accessibility">
        <h2 class="comp-section-title">Accesibilidad</h2>
        <div class="comp-a11y-grid">
          <div class="comp-a11y-item">
            <div class="comp-a11y-icon">⌨️</div>
            <div>
              <div class="comp-a11y-label">Teclado</div>
              <div class="comp-a11y-text">Todos los componentes son navegables con Tab / Shift+Tab y operables con Enter / Espacio.</div>
            </div>
          </div>
          <div class="comp-a11y-item">
            <div class="comp-a11y-icon">🔊</div>
            <div>
              <div class="comp-a11y-label">Screen readers</div>
              <div class="comp-a11y-text">Usan roles ARIA, aria-labels y estados semánticos para anunciar información correctamente.</div>
            </div>
          </div>
          <div class="comp-a11y-item">
            <div class="comp-a11y-icon">🎨</div>
            <div>
              <div class="comp-a11y-label">Contraste</div>
              <div class="comp-a11y-text">Los colores cumplen con WCAG 2.1 AA (relación de contraste ≥ 4.5:1 para texto).</div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Componentes relacionados ───────────────────────────────────── -->
      {catComponents.length > 0 && (
        <section class="comp-section" id="related">
          <h2 class="comp-section-title">Relacionados en {comp.category}</h2>
          <div class="comp-related-grid">
            {catComponents.slice(0, 8).map((c) => (
              <a class="comp-related-card" href={`${import.meta.env.BASE_URL}components/${c.slug}`}>
                <div class="comp-related-initial">{c.label.charAt(0)}</div>
                <div>
                  <div class="comp-related-name">{c.label}</div>
                  <div class="comp-related-tag">&lt;{c.tag}&gt;</div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

    </main>

    <!-- ── Right TOC ─────────────────────────────────────────────────────── -->
    <nav class="comp-toc" aria-label="En esta página">
      <div class="comp-toc-title">En esta página</div>
      {sections.map((s) => (
        <a class="comp-toc-item" href={`#${s.id}`}>{s.label}</a>
      ))}
      <a class="comp-toc-item" href="#accessibility">Accesibilidad</a>
      {catComponents.length > 0 && <a class="comp-toc-item" href="#related">Relacionados</a>}
    </nav>

  </div>
</BaseLayout>

<script>
  // Copy button
  document.querySelectorAll<HTMLButtonElement>('.comp-copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const code = btn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(code);
        (window as any).__showCopyToast?.();
        const orig = btn.innerHTML;
        btn.innerHTML = '✓ Copiado';
        btn.classList.add('copied');
        setTimeout(() => { btn.innerHTML = orig; btn.classList.remove('copied'); }, 1800);
      } catch {}
    });
  });

  // TOC active link on scroll
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.comp-toc-item');
  const headings = document.querySelectorAll<HTMLElement>('.comp-section');
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          tocLinks.forEach(l => l.classList.remove('active'));
          const link = document.querySelector<HTMLAnchorElement>(`.comp-toc-item[href="#${entry.target.id}"]`);
          link?.classList.add('active');
        }
      }
    },
    { rootMargin: '-20% 0px -60% 0px' }
  );
  headings.forEach(h => observer.observe(h));
</script>

<style>
  .comp-page {
    display: flex;
    min-height: 100vh;
    font-family: var(--font-sans);
  }

  /* ── Left sidebar ──────────────────────────────────────────────────────── */
  .comp-sidebar {
    width: 240px;
    height: 100vh;
    background: var(--sp-bg-subtle);
    border-right: 1px solid var(--sp-border);
    position: fixed;
    top: 0; left: 0;
    overflow-y: auto;
    z-index: 100;
    padding-bottom: 24px;
  }
  .comp-sidebar-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 18px 16px 14px;
    font-weight: 700;
    font-size: 1rem;
    color: var(--sp-primary);
    border-bottom: 1px solid var(--sp-border);
    text-decoration: none;
  }
  .comp-nav-back { padding: 8px 10px 4px; border-bottom: 1px solid var(--sp-border-subtle); }
  .comp-nav-back-link {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: .8rem; color: var(--sp-text-muted); text-decoration: none;
    padding: 5px 8px; border-radius: var(--radius-sm);
    transition: background .15s, color .15s;
  }
  .comp-nav-back-link:hover { background: var(--sp-bg-muted); color: var(--sp-text); }
  .comp-nav-group { padding: 4px 0; }
  .comp-nav-title {
    font-size: .65rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: .08em; color: var(--sp-text-muted); padding: 8px 16px 3px;
  }
  .comp-nav-item {
    display: flex; align-items: center; gap: 7px;
    padding: 5px 16px; font-size: .82rem; color: var(--sp-text-secondary);
    text-decoration: none; border-radius: var(--radius-sm); margin: 1px 6px;
    transition: background .12s, color .12s;
  }
  .comp-nav-item:hover { background: var(--sp-primary-bg); color: var(--sp-primary); }
  .comp-nav-item.active { background: var(--sp-primary-bg); color: var(--sp-primary); font-weight: 600; }

  /* ── Main ──────────────────────────────────────────────────────────────── */
  .comp-main {
    margin-left: 240px;
    margin-right: 210px;
    flex: 1;
    padding: 48px 52px 80px;
    max-width: 820px;
  }

  /* ── Breadcrumb ────────────────────────────────────────────────────────── */
  .comp-breadcrumb {
    display: flex; align-items: center; gap: 6px;
    font-size: .8rem; color: var(--sp-text-muted); margin-bottom: 28px;
  }
  .comp-bc-link { color: var(--sp-text-muted); text-decoration: none; }
  .comp-bc-link:hover { color: var(--sp-primary); }
  .comp-bc-sep { color: var(--sp-border-strong); }
  .comp-bc-current { color: var(--sp-text); font-weight: 500; }

  /* ── Component header ──────────────────────────────────────────────────── */
  .comp-header {
    display: flex; align-items: flex-start; gap: 16px; margin-bottom: 20px;
  }
  .comp-header-initial {
    width: 56px; height: 56px; flex-shrink: 0;
    background: var(--sp-primary); border-radius: var(--radius-lg);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.5rem; font-weight: 800; color: #fff;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--sp-primary) 35%, transparent);
  }
  .comp-header-category {
    font-size: .72rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: .06em; color: var(--sp-primary); margin-bottom: 4px;
  }
  .comp-header-title {
    font-size: 1.9rem; font-weight: 800; color: var(--sp-text);
    line-height: 1.2; margin-bottom: 8px;
  }
  .comp-header-desc {
    font-size: .95rem; color: var(--sp-text-muted); line-height: 1.6; max-width: 540px;
  }

  /* ── Tag row ───────────────────────────────────────────────────────────── */
  .comp-tag-row {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    margin-bottom: 44px; padding-bottom: 24px;
    border-bottom: 1px solid var(--sp-border-subtle);
  }
  .comp-tag-badge {
    font-family: var(--font-mono); font-size: .85rem;
    background: var(--sp-bg-muted); border: 1px solid var(--sp-border);
    padding: 4px 12px; border-radius: var(--radius-full); color: var(--sp-text);
  }
  /* Status + size pills */
  .comp-status-pill {
    display: inline-block; font-size: .72rem; font-weight: 700;
    padding: 3px 10px; border-radius: var(--radius-full);
    letter-spacing: .04em; line-height: 1.5;
  }
  .comp-status-pill--stable { background: var(--sp-bg-muted); color: var(--sp-text-muted); border: 1px solid var(--sp-border); }
  .comp-status-pill--new    { background: #ecfdf5; color: #059669; border: 1px solid #6ee7b7; }
  .comp-status-pill--beta   { background: #fffbeb; color: #d97706; border: 1px solid #fcd34d; }
  [data-theme="dark"] .comp-status-pill--new  { background: rgba(5,150,105,.15); color: #34d399; border-color: rgba(52,211,153,.3); }
  [data-theme="dark"] .comp-status-pill--beta { background: rgba(217,119,6,.15); color: #fbbf24; border-color: rgba(251,191,36,.3); }
  .comp-size-pill {
    display: inline-block; font-size: .72rem; font-family: var(--font-mono);
    padding: 3px 10px; border-radius: var(--radius-full);
    background: var(--sp-bg-subtle); color: var(--sp-text-muted);
    border: 1px solid var(--sp-border-subtle);
  }

  .comp-view-demo-link, .comp-stackblitz-link {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: .8rem; font-weight: 500; padding: 5px 12px;
    border-radius: var(--radius-sm); border: 1px solid var(--sp-border);
    text-decoration: none; transition: background .15s, color .15s;
    color: var(--sp-text-muted); background: var(--sp-bg);
  }
  .comp-view-demo-link:hover { background: var(--sp-primary-bg); color: var(--sp-primary); border-color: var(--sp-primary); }
  .comp-stackblitz-link:hover { background: rgba(59,130,246,.1); color: #3b82f6; border-color: #3b82f6; }

  /* ── Sections ──────────────────────────────────────────────────────────── */
  .comp-section { margin-bottom: 52px; scroll-margin-top: 24px; }
  .comp-section-title {
    font-size: 1.15rem; font-weight: 700; margin-bottom: 20px;
    padding-bottom: 10px; border-bottom: 2px solid var(--sp-border-subtle);
    color: var(--sp-text);
  }

  /* ── Steps (install) ───────────────────────────────────────────────────── */
  .comp-step-list { display: flex; flex-direction: column; gap: 16px; }
  .comp-step { display: flex; gap: 14px; }
  .comp-step-num {
    width: 26px; height: 26px; flex-shrink: 0;
    background: var(--sp-primary); color: #fff;
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-size: .75rem; font-weight: 700; margin-top: 2px;
  }
  .comp-step-body { flex: 1; }
  .comp-step-desc { font-size: .85rem; color: var(--sp-text-muted); margin: 0 0 8px; }

  /* ── Demo preview ─────────────────────────────────────────────────────── */
  .comp-demo-preview {
    padding: 32px 28px;
    background: var(--sp-bg-subtle);
    border: 1px solid var(--sp-border);
    border-radius: var(--radius-lg);
